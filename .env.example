# docpipe-maestro local environment template
# Copy to `.env` (already git-ignored) and lock down file permissions:
#   cp .env.example .env && chmod 600 .env
#
# Never commit real API keys. Set only the providers you intend to call.

# Groq (e.g. --model groq/llama-3.3-70b-versatile)
GROQ_API_KEY="your-groq-api-key-here"

# Together.ai (e.g. --model together_ai/meta-llama/Llama-3.3-70B-Instruct-Turbo)
# Note: LiteLLM also recognizes TOGETHER_API_KEY as an alias for TOGETHERAI_API_KEY.
TOGETHERAI_API_KEY="your-together-api-key-here"

# OpenAI (e.g. --model openai/gpt-4o-mini or custom OpenAI-compatible gateway)
OPENAI_API_KEY="your-openai-api-key-here"

# Anthropic (e.g. --model anthropic/claude-sonnet-4-20250514)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Google Gemini (e.g. --model gemini/gemini-2.5-flash)
GEMINI_API_KEY="your-gemini-api-key-here"

# Azure OpenAI (all three fields required for azure/<deployment>)
AZURE_API_KEY="your-azure-api-key-here"
AZURE_API_BASE="https://your-resource.openai.azure.com"
AZURE_API_VERSION="2024-10-21"

# Use LiteLLM's local bundled model cost map to prevent startup remote fetches
LITELLM_LOCAL_MODEL_COST_MAP="true"
